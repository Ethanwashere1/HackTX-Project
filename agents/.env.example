# Copy to .env (or api.env) and fill in. Empty or REPLACE_ME counts as unset.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash, gemini-3.1-flash-live-preview)
GEMINI_MODEL=
GEMINI_LIVE_MODEL=
# Optional: models tried in order when GEMINI_MODEL is overloaded (comma-separated)
# (default: gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest)
GEMINI_FALLBACK_MODELS=
# Core backend base URL (default http://localhost:8001)
BACKEND_URL=
# Shared secret for X-Internal-Key; must match the backend's INTERNAL_API_KEY
INTERNAL_API_KEY=
