# deploy/.env: copy to deploy/.env on the server. Read by docker compose for ${DOMAIN}.
# Your .tech domain, with its DNS A record pointing at the server. No scheme, no trailing slash.
DOMAIN=thesquadup.tech

# --- What changes in backend/.env and agents/.env for production ---------------------------
# docker-compose.yml already sets these, derived from DOMAIN and the compose network, and they
# override whatever is in the env files:
#   backend: APP_ENV=production
#            FRONTEND_ORIGIN=https://<domain>
#            OAUTH_REDIRECT_URL=https://<domain>/api/auth/google/callback
#            AGENTS_URL=http://agents:8000
#            AGENTS_WS_URL=wss://<domain>/agents/ws/interview
#            DEV_LOGIN=0
#   agents:  BACKEND_URL=http://backend:8001
#
# You must set these yourself:
#   backend/.env:
#     SESSION_SECRET=<strong random value>    python -c "import secrets; print(secrets.token_urlsafe(48))"
#                                             (the backend refuses to start without it)
#     DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/tsdb?sslmode=require   (TigerData)
#     GOOGLE_CLIENT_ID=... / GOOGLE_CLIENT_SECRET=...
#     GEMINI_API_KEY=...
#     SNOWFLAKE_ACCOUNT / _USER / _PASSWORD / _WAREHOUSE / _DATABASE / _SCHEMA / _ROLE
#     SERPAPI_API_KEY=...
#     INTERNAL_API_KEY=<random value>         the SAME value in agents/.env
#   agents/.env:
#     GEMINI_API_KEY=...
#     INTERNAL_API_KEY=<same value as the backend>
#
# Wrap any value that contains `$` in single quotes; compose otherwise treats `$` as a variable.
