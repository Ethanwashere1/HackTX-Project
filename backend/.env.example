# SquadUp backend settings. Copy to backend/.env and fill in.
# Values that are empty or contain REPLACE_ME count as "not configured": the app still boots
# and the feature that needs them fails clearly (or uses its fallback).

# local | test | production (the default when unset). Anything but local/test is a real
# deployment: cookies are always Secure and the app refuses to start without SESSION_SECRET.
APP_ENV=

# Postgres (TigerData). Unset/REPLACE_ME -> embedded Postgres via pgserver in backend/.pgdata.
DATABASE_URL=
# Tests. Unset/REPLACE_ME -> database "squadup_test" on the embedded Postgres.
TEST_DATABASE_URL=

# Signs the OAuth state cookie. Required outside local/test (the app won't start without it).
SESSION_SECRET=
# Only matters locally; cookies are always Secure outside local/test.
SESSION_COOKIE_SECURE=

# Google OAuth (authorization code flow).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud. Dev default: http://localhost:5173/api/auth/google/callback
OAUTH_REDIRECT_URL=

# Browser origin for CORS and post-login redirects. Default http://localhost:5173
FRONTEND_ORIGIN=

# Dev-only password-less login, POST /api/auth/dev-login {"email","name"}.
# Works only when DEV_LOGIN=1, APP_ENV is local/test and FRONTEND_ORIGIN is localhost.
DEV_LOGIN=

# Gemini embeddings. The schema stores vector(768); the app refuses to start if EMBEDDING_DIM
# is anything else.
GEMINI_API_KEY=
EMBEDDING_DIM=
# Embedding model, requested with outputDimensionality=768. Default gemini-embedding-001
GEMINI_EMBED_MODEL=
# Seconds before a Gemini embeddings call gives up. Default 10
GEMINI_TIMEOUT_S=

# Snowflake (embeddings + similarity search only).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional.
SNOWFLAKE_ROLE=
# Table holding the profile embeddings. Default PROFILE_EMBEDDINGS
SNOWFLAKE_TABLE=
# Seconds before a Snowflake query gives up (then pgvector is used). Default 5
SNOWFLAKE_TIMEOUT_S=

# SerpAPI social lookup.
SERPAPI_API_KEY=
# Seconds before a SerpAPI call gives up (the lookup is then skipped). Default 8
SERPAPI_TIMEOUT_S=
# Hours a cached social lookup is reused before it is fetched again. Default 24
SOCIAL_LOOKUP_TTL_HOURS=

# Gemini agents service and the shared key for X-Internal-Key.
AGENTS_URL=
# Browser-facing interview WebSocket returned by POST /api/events/{id}/interview.
# Empty -> AGENTS_URL with ws(s):// + /ws/interview. In production e.g. wss://squadup.tech/agents/ws/interview
AGENTS_WS_URL=
INTERNAL_API_KEY=
# Seconds before the agents /recommend call gives up (similarity order is used). Default 20
AGENTS_TIMEOUT_S=
# Seconds before /profile-overview gives up (prior overview kept). Default 15
AGENTS_OVERVIEW_TIMEOUT_S=
# Seconds before /generate-questions gives up (502 agents_unavailable). Default 10
AGENTS_QUESTIONS_TIMEOUT_S=
